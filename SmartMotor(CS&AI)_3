# this is for training a double motor to control single motor

import legoeducation as le
import time

# -------------------------------------------------------
SINGLE_MOTOR_CARD_COLOR  = le.LEGO_COLOR_PURPLE
SINGLE_MOTOR_CARD_SERIAL = '5164'

DOUBLE_MOTOR_CARD_COLOR  = le.LEGO_COLOR_RED
DOUBLE_MOTOR_CARD_SERIAL = '1133'
# -------------------------------------------------------

print("Connecting to devices...")

singlemotor = le.SingleMotor()
singlemotor.connect(card_color=SINGLE_MOTOR_CARD_COLOR, card_serial=SINGLE_MOTOR_CARD_SERIAL)
if not singlemotor.connected:
    print("Error: Single motor not connected.")
    exit(1)
print("Single motor connected.")

doublemotor = le.DoubleMotor()
doublemotor.connect(card_color=DOUBLE_MOTOR_CARD_COLOR, card_serial=DOUBLE_MOTOR_CARD_SERIAL)
if not doublemotor.connected:
    print("Error: Double motor not connected.")
    exit(1)
print("Double motor connected.")

training_data = []

last_gesture_time = 0
GESTURE_COOLDOWN  = 1.0  # seconds


def get_single_motor_angle():
    return singlemotor.motor.position % 360


def get_tilt():
    return doublemotor.imu_device.pitch


def check_gesture():
    """Returns 'tap', 'flip', or None."""
    global last_gesture_time
    now = time.time()
    if now - last_gesture_time < GESTURE_COOLDOWN:
        return None

    # Tap via gesture detector
    gesture = doublemotor.imu_gesture.gesture
    if gesture == le.MOTION_GESTURE_TAPPED:
        last_gesture_time = now
        return 'tap'

    # Flip via orientation — triggers when double motor is held upside down
    orientation = doublemotor.imu_device.orientation
    if orientation == le.DEVICE_FACE_BOTTOM:
        last_gesture_time = now
        return 'flip'

    return None


def record_pair():
    tilt     = get_tilt()
    position = get_single_motor_angle()
    training_data.append((tilt, position))
    training_data.sort(key=lambda p: p[0])
    doublemotor.beep(pattern=le.SOUND_PATTERN_BEEP_SINGLE, frequency=880)
    print(f"\n[RECORDED] Tilt: {tilt} | Motor angle: {position} | Total: {len(training_data)}")


def predict_position(tilt):
    if len(training_data) < 2:
        return get_single_motor_angle()

    if tilt <= training_data[0][0]:
        return training_data[0][1]
    if tilt >= training_data[-1][0]:
        return training_data[-1][1]

    for i in range(len(training_data) - 1):
        t0, p0 = training_data[i]
        t1, p1 = training_data[i + 1]
        if t0 <= tilt <= t1:
            ratio = (tilt - t0) / (t1 - t0)
            return p0 + ratio * (p1 - p0)


# --- TRAINING PHASE ---
print("\n=== TRAINING MODE ===")
print("Tilt the double motor to different angles")
print("TAP   the double motor = record (tilt → single motor angle) pair")
print("FLIP  the double motor upside down = exit training and start run (need at least 2 points)")
print("")

while True:
    tilt     = get_tilt()
    position = get_single_motor_angle()
    gesture  = check_gesture()

    if gesture == 'tap':
        record_pair()

    elif gesture == 'flip':
        if len(training_data) < 2:
            print("\nNeed at least 2 data points! Keep training.")
            doublemotor.beep(pattern=le.SOUND_PATTERN_BEEP_SINGLE, frequency=220)
        else:
            print(f"\nExiting training with {len(training_data)} data points.")
            break

    print(f"Tilt (pitch): {tilt:>6} | Motor angle (0-360): {position:>6} | Points: {len(training_data)}", end='\r')
    time.sleep(0.05)

# --- RUN PHASE ---
doublemotor.beep(pattern=le.SOUND_PATTERN_BEEP_SINGLE, frequency=440)
print("\n\n=== RUN MODE ===")
print("Tilt the double motor — single motor moves to learned angle. Ctrl+C to stop.\n")

try:
    while True:
        tilt     = get_tilt()
        target   = predict_position(tilt)
        position = get_single_motor_angle()
        diff     = int(target - position)

        if abs(diff) > 5:
            singlemotor.motor_run_for_degrees(diff)

        print(f"Tilt: {tilt:>6} | Target angle: {target:>6.1f} | Motor angle: {position:>6}", end='\r')
        time.sleep(0.1)

except KeyboardInterrupt:
    print("\n\nStopping...")

finally:
    singlemotor.motor_stop()
    singlemotor.disconnect()
    doublemotor.disconnect()
    print("All devices disconnected.")
    exit(0)
