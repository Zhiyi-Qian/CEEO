#this code takes controller as a sensor to train the motor

import legoeducation as le
import time

# -------------------------------------------------------
MOTOR_CARD_COLOR   = le.LEGO_COLOR_AZURE
MOTOR_CARD_SERIAL  = '0000'

CONTROLLER_CARD_COLOR  = le.LEGO_COLOR_AZURE
CONTROLLER_CARD_SERIAL = '0001'
# -------------------------------------------------------

print("Connecting to devices...")

motor = le.SingleMotor()
motor.connect(card_color=MOTOR_CARD_COLOR, card_serial=MOTOR_CARD_SERIAL)
if not motor.connected:
    print("Error: Motor not connected.")
    exit(1)
print("Motor connected.")

controller = le.Controller()
controller.connect(card_color=CONTROLLER_CARD_COLOR, card_serial=CONTROLLER_CARD_SERIAL)
if not controller.connected:
    print("Error: Controller not connected.")
    exit(1)
print("Controller connected.")

training_data = []


def get_motor_angle():
    # % 360 wraps any value into 0-359
    # works for negative too: -1 % 360 = 359, 361 % 360 = 1
    return motor.motor.position % 360


def record_pair():
    right_angle = controller.sensor.rightAngle
    position    = get_motor_angle()
    training_data.append((right_angle, position))
    training_data.sort(key=lambda p: p[0])
    controller.beep(pattern=le.SOUND_PATTERN_BEEP_SINGLE, frequency=880)
    print(f"\n[RECORDED] Right lever angle: {right_angle} | Motor angle: {position} | Total: {len(training_data)}")


def predict_position(right_angle):
    if len(training_data) < 2:
        return get_motor_angle()  # stay still if not enough data

    if right_angle <= training_data[0][0]:
        return training_data[0][1]
    if right_angle >= training_data[-1][0]:
        return training_data[-1][1]

    for i in range(len(training_data) - 1):
        a0, p0 = training_data[i]
        a1, p1 = training_data[i + 1]
        if a0 <= right_angle <= a1:
            ratio = (right_angle - a0) / (a1 - a0)
            return p0 + ratio * (p1 - p0)


# --- TRAINING PHASE ---
print("\n=== TRAINING MODE ===")
print("Rotate motor by hand to desired angle")
print("Left lever UP  = record (right lever angle → motor angle) pair")
print("BOTH levers UP = exit training and start run (need at least 2 points)")
print("")

left_was_up = False

while True:
    left        = controller.sensor.leftPercent
    right       = controller.sensor.rightPercent
    right_angle = controller.sensor.rightAngle
    position    = get_motor_angle()

    # NO motor commands here — motor is free to be rotated by hand

    # Record on left lever push (debounced)
    if left > 50 and not left_was_up:
        record_pair()
        left_was_up = True
    elif left <= 50:
        left_was_up = False

    # Both levers up = switch to run mode
    if left > 70 and right > 70:
        if len(training_data) < 2:
            print("\nNeed at least 2 data points! Keep training.")
            time.sleep(1)
        else:
            print(f"\nExiting training with {len(training_data)} data points.")
            break

    print(f"Right lever angle: {right_angle:>6} | Motor angle (0-360): {position:>6} | Points: {len(training_data)}", end='\r')
    time.sleep(0.05)

# --- RUN PHASE ---
controller.beep(pattern=le.SOUND_PATTERN_BEEP_SINGLE, frequency=440)
print("\n\n=== RUN MODE ===")
print("Move the right lever — motor moves to learned angle. Ctrl+C to stop.\n")

try:
    while True:
        right_angle = controller.sensor.rightAngle
        target      = predict_position(right_angle)
        position    = get_motor_angle()
        diff        = int(target - position)

        if abs(diff) > 5:
            motor.motor_run_for_degrees(diff)

        print(f"Right angle: {right_angle:>6} | Target: {target:>6.1f} | Motor angle: {position:>6}", end='\r')
        time.sleep(0.1)

except KeyboardInterrupt:
    print("\n\nStopping...")

finally:
    motor.motor_stop()
    motor.disconnect()
    controller.disconnect()
    print("All devices disconnected.")
    exit(0)
